<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EppoTesting.Scripts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <CoreManagedDll Condition="'$(CoreManagedDll)' == '' and '$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)../../../build/bin/Debug-windows-x86_64/EppoScriptCore/EppoScriptCore.dll</CoreManagedDll>
    <CoreManagedDll Condition="'$(CoreManagedDll)' == '' and '$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)../../../build/bin/Release-windows-x86_64/EppoScriptCore/EppoScriptCore.dll</CoreManagedDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>../../../build/bin/Debug-windows-x86_64/EppoEngineTesting/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>../../../build/bin/Release-windows-x86_64/EppoEngineTesting/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <!-- The runtime loads the core separately, so don't copy it with the harness. -->
    <Reference Include="EppoScriptCore">
      <HintPath>$(CoreManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
