<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EppoTesting.Scripts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <!-- CoreManagedDll is passed by CMake; the built core assembly is not copied
         to output (Private=false) because the runtime loads it as the core. -->
    <Reference Include="EppoScriptCore.Managed">
      <HintPath>$(CoreManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
