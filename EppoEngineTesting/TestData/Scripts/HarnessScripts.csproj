<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EppoTesting.Scripts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- CMake passes CoreManagedDll as a global property, which wins over this.
         The fallback exists only so IDEs and language servers opening the project
         standalone can still resolve the core types. -->
    <CoreManagedDll Condition="'$(CoreManagedDll)' == ''">$(MSBuildThisFileDirectory)../../../build/debug/EppoScriptCore.dll</CoreManagedDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <!-- CMake passes CoreManagedDll; the runtime loads the core, so don't copy it. -->
    <Reference Include="EppoScriptCore">
      <HintPath>$(CoreManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
