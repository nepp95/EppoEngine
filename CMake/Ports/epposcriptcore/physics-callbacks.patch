--- a/EppoScriptCore.Managed/Source/Core/NativeCallbacks.cs
+++ b/EppoScriptCore.Managed/Source/Core/NativeCallbacks.cs
@@ -1,3 +1,5 @@
+using System.Runtime.InteropServices;
+
 namespace EppoScriptCore.Core
 {
     public static class NativeCallbacks
@@ -5,7 +7,46 @@ namespace EppoScriptCore.Core
         internal delegate void LogCallbackDelegate(byte level, IntPtr message);
         internal static LogCallbackDelegate? LogCallback;
 
-        internal delegate bool InputIsKeyDownDelegate(uint keyCode);
+        internal delegate bool InputIsKeyDownDelegate(KeyCode keyCode);
         internal static InputIsKeyDownDelegate? InputIsKeyDown;
+
+        internal delegate void ApplyLinearImpulseDelegate(ulong entityId, EppoScriptCore.Math.Vector3 impulse);
+        internal static ApplyLinearImpulseDelegate? ApplyLinearImpulse;
+
+        internal delegate void GetLinearVelocityDelegate(ulong entityId, out EppoScriptCore.Math.Vector3 velocity);
+        internal static GetLinearVelocityDelegate? GetLinearVelocity;
+
+        internal delegate void SetLinearVelocityDelegate(ulong entityId, EppoScriptCore.Math.Vector3 velocity);
+        internal static SetLinearVelocityDelegate? SetLinearVelocity;
+
+        // Mirrors the native NativeCallbacks struct field-for-field (same order).
+        // Native passes it by pointer, so adding a callback is just a field here +
+        // there + one Bind line below, never a signature change.
+        [StructLayout(LayoutKind.Sequential)]
+        private struct Table
+        {
+            public IntPtr Log;
+            public IntPtr InputIsKeyDown;
+            public IntPtr ApplyLinearImpulse;
+            public IntPtr GetLinearVelocity;
+            public IntPtr SetLinearVelocity;
+        }
+
+        internal static void Register(IntPtr tablePtr)
+        {
+            if (tablePtr == IntPtr.Zero)
+                return;
+
+            Table table = Marshal.PtrToStructure<Table>(tablePtr);
+
+            LogCallback = Bind<LogCallbackDelegate>(table.Log);
+            InputIsKeyDown = Bind<InputIsKeyDownDelegate>(table.InputIsKeyDown);
+            ApplyLinearImpulse = Bind<ApplyLinearImpulseDelegate>(table.ApplyLinearImpulse);
+            GetLinearVelocity = Bind<GetLinearVelocityDelegate>(table.GetLinearVelocity);
+            SetLinearVelocity = Bind<SetLinearVelocityDelegate>(table.SetLinearVelocity);
+        }
+
+        private static T? Bind<T>(IntPtr ptr) where T : Delegate
+            => ptr == IntPtr.Zero ? null : Marshal.GetDelegateForFunctionPointer<T>(ptr);
     }
 }
