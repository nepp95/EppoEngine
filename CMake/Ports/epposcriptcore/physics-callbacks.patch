diff --git a/EppoScriptCore.Managed/Source/ECS/Component.cs b/EppoScriptCore.Managed/Source/ECS/Component.cs
new file mode 100644
index 0000000..ba7b665
--- /dev/null
+++ b/EppoScriptCore.Managed/Source/ECS/Component.cs
@@ -0,0 +1,10 @@
+namespace EppoScriptCore.ECS
+{
+    // Base for the managed component accessors. A component wrapper is a thin
+    // handle bound to an entity; it carries no state of its own and forwards to
+    // the native engine (via NativeCallbacks) using the entity's id.
+    public abstract class Component
+    {
+        public Entity Entity { get; internal set; }
+    }
+}
diff --git a/EppoScriptCore.Managed/Source/ECS/Entity.cs b/EppoScriptCore.Managed/Source/ECS/Entity.cs
index 9bc1390..168c7a5 100644
--- a/EppoScriptCore.Managed/Source/ECS/Entity.cs
+++ b/EppoScriptCore.Managed/Source/ECS/Entity.cs
@@ -14,6 +14,14 @@ namespace EppoScriptCore.ECS
 
         public bool IsValid => Id != 0;
 
+        // Returns a component accessor bound to this entity. The wrapper is created
+        // on demand and holds no state, so it is cheap; it does not verify the
+        // entity actually has the component (calls no-op on the native side if not).
+        public T GetComponent<T>() where T : Component, new()
+        {
+            return new T { Entity = this };
+        }
+
         public static Entity Null => new Entity(0);
 
         public override string ToString() => $"Entity({Id})";
diff --git a/EppoScriptCore.Managed/Source/ECS/RigidBody.cs b/EppoScriptCore.Managed/Source/ECS/RigidBody.cs
new file mode 100644
index 0000000..075b997
--- /dev/null
+++ b/EppoScriptCore.Managed/Source/ECS/RigidBody.cs
@@ -0,0 +1,29 @@
+using EppoScriptCore.Core;
+using EppoScriptCore.Math;
+
+namespace EppoScriptCore.ECS
+{
+    // Physics body accessor. Obtain via entity.GetComponent<RigidBody>() (or, from
+    // a ScriptBehaviour, GetComponent<RigidBody>()). Calls forward to the native
+    // physics world; if the entity has no body the engine logs and no-ops.
+    public class RigidBody : Component
+    {
+        public void ApplyLinearImpulse(Vector3 impulse)
+        {
+            NativeCallbacks.ApplyLinearImpulse?.Invoke(Entity.Id, impulse);
+        }
+
+        public Vector3 LinearVelocity
+        {
+            get
+            {
+                if (NativeCallbacks.GetLinearVelocity is null)
+                    return Vector3.Zero;
+
+                NativeCallbacks.GetLinearVelocity(Entity.Id, out Vector3 velocity);
+                return velocity;
+            }
+            set => NativeCallbacks.SetLinearVelocity?.Invoke(Entity.Id, value);
+        }
+    }
+}
