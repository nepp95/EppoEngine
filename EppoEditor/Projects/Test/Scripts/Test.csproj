<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The editor passes CoreManagedDll as a global property, which wins over
         this. The fallback exists only so IDEs and language servers opening the
         project standalone can still resolve the core types. -->
    <CoreManagedDll Condition="'$(CoreManagedDll)' == ''">$(MSBuildThisFileDirectory)../../../../build/bin/Debug-windows-x86_64/EppoScriptCore/EppoScriptCore.dll</CoreManagedDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoreManagedDll is passed by the editor at build time; the runtime loads
         the core, so this project doesn't copy it. -->
    <Reference Include="EppoScriptCore">
      <HintPath>$(CoreManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
